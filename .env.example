# VentasRoma — copiar a .env y rellenar. El .env NO va al repo.

# Supabase (proyecto propio, no el de Rservasroma)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudinary (cloud propio). El cloud name es público: va en las URLs de imagen.
VITE_CLOUDINARY_CLOUD_NAME=

# ─── Solo en el servidor. Nunca con prefijo VITE_: eso las publicaría ───
# Secrets de las Edge Functions: supabase secrets set CLAVE=valor
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
APP_URL=https://ventasroma.com

# Web Push (fase 3): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@ventasroma.com
